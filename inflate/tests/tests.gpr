with "../inflate.gpr";

project Tests is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("test_inflate.adb");

   --  Keep language run-time checks on: the harness treats any propagated
   --  exception as a test failure. Proof contracts are disabled by the same
   --  configuration as the imported debug library.
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2012", "-g", "-O1");
      for Local_Configuration_Pragmas use "../debug.adc";
   end Compiler;
end Tests;
