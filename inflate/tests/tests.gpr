with "../inflate.gpr";

project Tests is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("test_inflate.adb");

   --  All checks on: the harness exists to demonstrate that no input,
   --  however hostile, raises anything.
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2012", "-gnata", "-g", "-O1");
   end Compiler;
end Tests;
