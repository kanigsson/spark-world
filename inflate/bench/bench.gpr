with "../inflate.gpr";

project Bench is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("bench_inflate.adb");
   for Languages use ("Ada");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2012", "-O2", "-gnatp", "-gnatn");
   end Compiler;
end Bench;
