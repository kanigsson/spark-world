with "git_changes.gpr";

project Git_Changes_CLI is
   for Languages use ("Ada");
   for Source_Dirs use ("app");
   for Object_Dir use "obj/cli";
   for Exec_Dir use "bin";
   for Main use ("git_changes_main.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-g", "-O0");
   end Compiler;

   package Builder is
      for Executable ("git_changes_main.adb") use "git-changes";
   end Builder;
end Git_Changes_CLI;
