with "bwt.gpr";
with "../../tools/testing/testing.gpr";
project Bench is
   for Source_Dirs use ("bench");
   for Object_Dir use "obj/" & BWT.Build & "/bench";
   for Exec_Dir use "bin/" & BWT.Build;
   for Main use ("bench_bwt.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-O2", "-gnatp", "-gnatn");
   end Compiler;
end Bench;
