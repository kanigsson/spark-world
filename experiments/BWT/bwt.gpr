project BWT is
   type Build_Mode is ("runtime", "checks");
   Build : Build_Mode := external ("BWT_BUILD", "runtime");
   for Source_Dirs use ("src");
   for Object_Dir use "obj/" & Build & "/core";
   package Compiler is
      case Build is
         when "runtime" =>
            for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-O2");
         when "checks" =>
            for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatwa", "-O2");
      end case;
   end Compiler;
   package Prove is
      for Proof_Dir use "proof";
      for Proof_Switches ("Ada") use
        ("--report=all", "--checks-as-errors=on");
   end Prove;
end BWT;
