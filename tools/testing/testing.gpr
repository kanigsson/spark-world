--  The shared test scaffolding: see src/test_checks.ads. A library project so
--  that a project's test project withs it the same way it withs anything else
--  in the repository, by a path from the root.
--
--  Not a candidate for libs/: nothing here ships, and the tier is for
--  libraries with a stated API and external clients. It sits beside the other
--  repo-wide drivers instead.
library project Testing is

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Name use "spark_world_testing";
   for Library_Dir use "lib";
   for Library_Kind use "static";

   package Compiler is
      --  A test build: checks on, no optimisation, debuggable.
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatwa", "-g", "-O0");
   end Compiler;

end Testing;
