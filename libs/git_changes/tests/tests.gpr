with "../git_changes.gpr";
with "../../../tools/testing/testing.gpr";

project Tests is
   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("test_core.adb", "api_probe.adb", "stale_content_probe.adb", "snapshot_probe.adb", "stdout_probe.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-g", "-O0");
   end Compiler;
end Tests;
