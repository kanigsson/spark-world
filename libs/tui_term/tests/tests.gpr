with "../tui_term.gpr";
with "../../../tools/testing/testing.gpr";

project Tests is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("test_output.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2012", "-gnata", "-g", "-O0");
   end Compiler;
end Tests;
