with "../json.gpr";
with "../../../tools/testing/testing.gpr";

project Tests is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("test_json.adb", "test_walk.adb", "test_unicode.adb");

   --  All checks on: the harness treats any propagated exception as a
   --  test failure.
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-g", "-O1");
   end Compiler;
end Tests;
