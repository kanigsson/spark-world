--  M2 pressure-test spike: canonical-Huffman construction correctness
--  (ghost summation, offsets bound, Kraft connection) in isolation.

project M2_Kraft is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Main use ("kraft_test.adb");
   for Exec_Dir use ".";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnata", "-g", "-O0");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--report=statistics");
   end Prove;

end M2_Kraft;
