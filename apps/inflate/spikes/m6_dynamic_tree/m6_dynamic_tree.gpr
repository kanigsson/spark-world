--  Focused M6 dynamic-Huffman tree-builder proof and runtime harness.

project M6_Dynamic_Tree is

   for Source_Dirs use ("src", "../../src");
   for Object_Dir use "obj";
   for Main use ("dynamic_tree_test.adb");
   for Exec_Dir use ".";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2012", "-gnatwa", "-g", "-O0");
      for Local_Configuration_Pragmas use "../../debug.adc";
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--report=statistics");
   end Prove;

end M6_Dynamic_Tree;
