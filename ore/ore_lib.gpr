library project Ore_Lib is

   --  "debug" keeps the executable contracts of the library; "release" drops
   --  them, on the grounds that they have been proved.  Ghost code is ignored
   --  in both modes, see gnat.adc.
   type Build_Mode_Type is ("debug", "release");
   Build_Mode : Build_Mode_Type := external ("ORE_BUILD_MODE", "debug");

   Mode_Switches := ();
   case Build_Mode is
      when "debug"   => Mode_Switches := ("-gnata");
      when "release" => Mode_Switches := ("-O2");
   end case;

   for Library_Name use "ore";
   for Library_Kind use "static";
   for Source_Dirs use ("src");
   for Object_Dir use "obj/lib";
   for Library_Dir use "lib";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022") & Mode_Switches;
      for Local_Configuration_Pragmas use "gnat.adc";
   end Compiler;

   --  Install the GNATprove summary files (global effects, termination) next
   --  to the installed library, so that clients of the installed library get
   --  that information rather than assuming it.  The destination must match
   --  the directory gprinstall puts the ALI files in.
   package Install is
      for Artifacts ("lib/ore_lib/gnatprove") use
        (Ore_Lib'Library_ALI_Dir & "/gnatprove/*.ali");
   end Install;

   package Prove is
      for Proof_Dir use "proof/lib";
      for Proof_Switches ("Ada") use
        ("--mode=all", "--level=2", "--timeout=30");
   end Prove;

end Ore_Lib;
