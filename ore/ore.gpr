with "ore_lib.gpr";

project Ore is

   for Source_Dirs use ("tests/proof");
   for Object_Dir use "obj/proof_clients";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata");
      for Local_Configuration_Pragmas use "gnat.adc";
   end Compiler;

   package Prove is
      for Proof_Dir use "proof/clients";
      --  The timeout is set by the hardest goals in the library: a
      --  bit-level contract on a 64-bit word is a bit-vector problem with a
      --  variable shift amount, which the provers solve in seconds on their
      --  own and in tens of seconds when a whole run competes for the cores.
      for Proof_Switches ("Ada") use
        ("--mode=all", "--level=2", "--timeout=60");
   end Prove;

end Ore;
