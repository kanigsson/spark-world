--  The driver crate: the one place the OS lives. It reads the terminal, writes
--  ANSI/SGR, owns raw mode and signals. The syscall shims' bodies and the
--  controlled/interrupt machinery are SPARK_Mode Off; the byte-level work on
--  either side of them — key decoding, escape/SGR assembly — is proved SPARK.

with "../tui/tui.gpr";

library project Tui_Term is

   for Library_Name use "tui_term";
   for Library_Kind use "static";
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";

   package Compiler is
      case Tui.Mode is
         when "debug" =>
            for Default_Switches ("Ada") use
              ("-gnat2012", "-gnatwa", "-gnata", "-g", "-O0");
         when "release" =>
            for Default_Switches ("Ada") use ("-gnat2012", "-gnatwa", "-O2");
      end case;
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--report=statistics");
   end Prove;

end Tui_Term;
