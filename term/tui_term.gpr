--  The driver crate: the one place the OS lives. It reads the terminal, writes
--  ANSI/SGR, owns raw mode and signals. SPARK_Mode is Off here (syscalls and
--  controlled/interrupt machinery); the engine it serves stays pure and proved.

with "../core/tui_core.gpr";
with "../surface/tui_surface.gpr";
with "../input/tui_input.gpr";

library project Tui_Term is

   for Library_Name use "tui_term";
   for Library_Kind use "static";
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2012", "-gnatwa", "-gnata", "-g", "-O0");
   end Compiler;

end Tui_Term;
