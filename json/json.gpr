with "../unicode_text/unicode_text_lib.gpr";

--  The library crate: pure SPARK, no I/O, no OS, no heap. A pull-cursor
--  JSON (RFC 8259) parser over caller-provided buffers, with separate
--  string-escape decoding and typed number conversion.

library project Json is

   --  "debug" keeps -gnata (contracts run as assertions) and -O0; "release"
   --  drops assertions and optimises.
   --  Select with `-XMODE=debug` on the gprbuild command line.
   type Mode_Type is ("debug", "release");
   Mode : Mode_Type := external ("MODE", "release");

   for Library_Name use "json";
   for Library_Kind use "static";
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";

   package Compiler is
      case Mode is
         when "debug" =>
            for Default_Switches ("Ada") use
              ("-gnat2022", "-gnatwa", "-gnata", "-g", "-O0");
         when "release" =>
            for Default_Switches ("Ada") use
              ("-gnat2022", "-gnatwa", "-O2", "-gnatp");
      end case;
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--report=statistics");
   end Prove;

end Json;
